{
  "name": "@paymoon/commerce-api",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dev": "node --env-file=../../.env --watch dist/main.js",
    "start": "node --env-file=../../.env dist/main.js",
    "test": "node --test dist/*.test.js",
    "start:production": "node dist/main.js"
  },
  "dependencies": {
    "@paymoon/db": "workspace:*",
    "@paymoon/auth": "workspace:*",
    "@paymoon/config": "workspace:*",
    "@paymoon/events": "workspace:*",
    "@paymoon/logger": "workspace:*",
    "@paymoon/observability": "workspace:*",
    "@paymoon/validation": "workspace:*",
    "@paymoon/money": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "fastify": "5.11.3",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:",
    "bullmq": "^5.58.5",
    "ioredis": "^5.8.0",
    "@fastify/static": "^8.3.0",
    "@vercel/blob": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
