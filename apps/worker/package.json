{
  "name": "@paymoon/worker",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dev": "node --env-file=../../.env --watch dist/main.js",
    "start": "node --env-file=../../.env dist/main.js",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@paymoon/config": "workspace:*",
    "@paymoon/db": "workspace:*",
    "@paymoon/events": "workspace:*",
    "@paymoon/logger": "workspace:*",
    "bullmq": "^5.58.5",
    "ioredis": "^5.8.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  }
}
