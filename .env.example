NODE_ENV=development
COMMERCE_DATABASE_URL=postgresql://paymoon:paymoon_local_only@localhost:55432/paymoon_dev
COMMERCE_REDIS_URL=redis://localhost:56379/0
COMMERCE_API_PORT=4000
COMMERCE_WORKER_PORT=4001
COMMERCE_CORS_ORIGINS=http://localhost:4100,http://localhost:4101,http://localhost:4102,https://localhost,http://localhost
LOG_LEVEL=info
# Optional; omitted means disabled. Never expose as NEXT_PUBLIC_*.
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=
# COMMERCE_DATABASE_TEST_URL=postgresql://paymoon:paymoon_local_only@localhost:55432/paymoon_test
# COMMERCE_REDIS_TEST_URL=redis://localhost:56379/1

# Official Instagram Login (server only; leave unset until a Meta app exists)
# INSTAGRAM_APP_ID=
# INSTAGRAM_API_VERSION=
# INSTAGRAM_REDIRECT_URI=https://your-api.example/v1/instagram/oauth/callback
# INSTAGRAM_TOKEN_ENCRYPTION_KEY= # 32 random bytes encoded as 64 hex characters
# INSTAGRAM_SCOPES=instagram_business_basic

# Runtime API URL; use public HTTPS for phone builds. NEXT_PUBLIC_API_URL is embedded at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
COMMERCE_API_PUBLIC_URL=http://localhost:4000
COMMERCE_MEDIA_DIR=../../var/media
# Comma-separated UUIDs; register an account then explicitly grant platform administrator.
COMMERCE_ADMIN_USER_IDS=
# disabled by default; sandbox allowed only in development/test and never transfers real money.
COMMERCE_PAYMENT_MODE=disabled

# Hosted API media: local for development, vercel_blob for Vercel
COMMERCE_MEDIA_STORAGE=local
# COMMERCE_MEDIA_PUBLIC_URL=https://YOUR_STORE.public.blob.vercel-storage.com
# BLOB_READ_WRITE_TOKEN=configure-on-api-server-only
# Web deployments use NEXT_PUBLIC_API_URL=/api and this server-only proxy origin.
# COMMERCE_API_PROXY_URL=https://paymoon-api.example.com
# Capacitor builds instead use NEXT_PUBLIC_API_URL=https://paymoon-api.example.com
