# Non-secret template only. Enter real values directly in Vercel/server settings.
NODE_ENV=production
COMMERCE_ENVIRONMENT=staging
COMMERCE_PAYMENT_MODE=sandbox
# Database must be isolated and named with _staging suffix for sandbox mode.
COMMERCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/paymoon_staging?sslmode=require
COMMERCE_REDIS_URL=rediss://default:PASSWORD@HOST:PORT
COMMERCE_API_PUBLIC_URL=https://YOUR_API.vercel.app
COMMERCE_CORS_ORIGINS=https://YOUR_MARKETPLACE.vercel.app,https://YOUR_SELLER.vercel.app,https://YOUR_ADMIN.vercel.app,https://localhost,http://localhost
COMMERCE_MEDIA_STORAGE=vercel_blob
COMMERCE_MEDIA_PUBLIC_URL=https://YOUR_STORE.public.blob.vercel-storage.com
BLOB_READ_WRITE_TOKEN=SET_IN_VERCEL_ONLY
COMMERCE_ADMIN_USER_IDS=
LOG_LEVEL=info
# Meta can be configured later; see .env.example and docs/instagram-mobile.md.

# worker for long-lived hosting; request for bounded Vercel processing.
COMMERCE_BACKGROUND_MODE=request
# Vercel cron: random secret of at least 32 characters, server-only.
# CRON_SECRET=SET_IN_SERVER_SETTINGS
