    "@paymoon/events": "workspace:*",
    "@paymoon/config": "workspace:*",
    "@paymoon/observability": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
